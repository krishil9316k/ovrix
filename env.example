# Copy this file to `.env` and fill it in. NEVER commit .env or paste these into index.html.

# Claude API (console.anthropic.com -> API keys)
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
# CLAUDE_MODEL=claude-sonnet-5-5

# Supabase -> Settings -> API. Use the NEW "ovrix" project (Mumbai), the one the website writes leads to.
# Table the website form writes to (default leads)
LEADS_TABLE=leads
SUPABASE_URL=https://YOUR-OVRIX-PROJECT.supabase.co
# The SECRET key (sb_secret_...). Server-only. This is NOT the publishable key used on the website.
SUPABASE_SERVICE_KEY=

# Discord (see discord/SERVER_SETUP.md)
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Members with this role (or the server owner) can press Approve / Reject
DISCORD_APPROVER_ROLE=Approver

# Tuning (optional)
POLL_SECONDS=30
MAX_ORDERS_PER_CYCLE=3
MAX_TOKENS=1800

# --- Billing agent (payment webhooks) ---
# Port the webhook server listens on. Point Stripe/Razorpay at https://YOUR-SERVER/webhooks/stripe and /webhooks/razorpay
PORT=3000
# Stripe -> Developers -> Webhooks -> signing secret (whsec_...). Leave empty to disable.
STRIPE_WEBHOOK_SECRET=
# Razorpay -> Settings -> Webhooks -> the secret you typed when creating the webhook. Leave empty to disable.
RAZORPAY_WEBHOOK_SECRET=

# --- Watchdog agent ---
# Public URL of the website, e.g. https://ovrix-kappo.vercel.app  (empty = skip site checks)
SITE_URL=
# The PUBLISHABLE key from the website (sb_publishable_...). Used to prove nobody can read your tables with it.
SUPABASE_PUBLISHABLE_KEY=
CHECK_MINUTES=30
DIGEST_HOUR=9
TIMEZONE=Asia/Kolkata
